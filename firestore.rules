rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔹 Transactions Collection
    match /transactions/{transactionId} {
      // Read only if the logged-in user's UID matches the document's userId
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Write only if the logged-in user's UID matches the userId being written
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // 🔹 Categories under each User
    match /users/{userId}/categories/{categoryId} {
      // Allow read/write only for that specific user
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
